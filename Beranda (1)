/* Hachila's Juice — style.css murni, tanpa framework */
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #FFFBEB;
  color: #431407;
  line-height: 1.6;
}
.container { max-width: 1000px; margin: 0 auto; padding: 0 16px; }

/* Navbar */
.navbar {
  position: sticky; top: 0; z-index: 10;
  background: #fff; border-bottom: 3px solid #F97316;
}
.nav-inner { display: flex; align-items: center; gap: 16px; padding: 10px 16px; }
.brand { display: flex; align-items: center; gap: 8px; font-weight: bold; color: #9A3412; text-decoration: none; font-size: 1.1rem; margin-right: auto; }
nav a { margin: 0 8px; color: #9A3412; text-decoration: none; font-weight: bold; }
nav a:hover { text-decoration: underline; }
#btn-gelap { border: 2px solid #F97316; background: #FFF7ED; border-radius: 8px; cursor: pointer; font-size: 1rem; padding: 4px 10px; }

/* Section */
section { background: #fff; border: 2px solid #FED7AA; border-radius: 16px; padding: 24px; margin: 24px 0; scroll-margin-top: 80px; }
h1 { font-size: 2.4rem; margin: 8px 0; color: #9A3412; }
h2 { color: #9A3412; border-left: 6px solid #F97316; padding-left: 10px; }
.tagline { font-size: 1.1rem; }
.badge { display: inline-block; background: #FEF3C7; border: 1px solid #F59E0B; padding: 4px 12px; border-radius: 999px; font-size: .9rem; }
.subjudul { color: #92400E; }
.mt { margin-top: 28px; }

/* Tombol */
.btn { display: inline-block; background: #F97316; color: #fff; padding: 10px 20px; border-radius: 10px; text-decoration: none; border: none; cursor: pointer; font-weight: bold; }
.btn:hover { background: #EA580C; }
.btn-outline { background: #fff; color: #9A3412; border: 2px solid #F97316; }
.hero { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
.hero-teks { flex: 1 1 300px; }
.hero-gambar { flex: 0 1 320px; margin: 0 auto; }
.hero-gambar img, .galeri img, .tim img { max-width: 100%; height: auto; border-radius: 12px; }
.hero-poin { list-style: none; padding: 0; display: flex; gap: 12px; flex-wrap: wrap; font-size: .9rem; }
